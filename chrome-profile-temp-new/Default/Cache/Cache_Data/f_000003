// ──── Build active points based on layer toggles ───────
function getVisiblePoints() {
  let pts = [];
  if (layerVis.argo)    pts = pts.concat(buildArgoPoints());
  if (layerVis.sensors) pts = pts.concat(buildSensors());
  return pts;
}

// ──── Globe initialisation ─────────────────────────────
const globe = Globe()(document.getElementById('globe-viz'))
  .width(window.innerWidth)
  .height(window.innerHeight)
  // Textures
  .globeImageUrl('https://cdn.jsdelivr.net/npm/three-globe/example/img/earth-night.jpg')
  .bumpImageUrl('https://cdn.jsdelivr.net/npm/three-globe/example/img/earth-topology.png')
  .backgroundColor('rgba(5,11,22,1)')

  // Atmosphere rim — the "glow edge" of the planet
  .atmosphereColor('#38bdf8')
  .atmosphereAltitude(0.20)

  // Starting viewpoint — Indian Ocean centred
  .pointOfView({ lat: 10, lng: 74, altitude: 2.05 }, 0)

  // ── Arcs layer ──
  .arcsData(buildArcs())
  .arcStartLat('startLat').arcStartLng('startLng')
  .arcEndLat('endLat').arcEndLng('endLng')
  .arcColor('color')
  .arcAltitude('alt')
  .arcStroke(0.28)
  .arcDashLength(0.38)
  .arcDashGap(0.18)
  .arcDashAnimateTime(1500)

  // ── Points layer ──
  .pointsData(getVisiblePoints())
  .pointLat('lat').pointLng('lng')
  .pointColor('color').pointRadius('radius')
  .pointAltitude(0.01)

  // ── Alert pulse rings ──
  .ringsData(ALERT_RINGS)
  .ringLat('lat').ringLng('lng')
  .ringColor('color')
  .ringMaxRadius('maxRadius')
  .ringPropagationSpeed('speed')
  .ringRepeatPeriod('period')

  // ── Floating geo-tag HTML labels ──
  .htmlElementsData(GEO_TAGS)
  .htmlLat(d => d.lat).htmlLng(d => d.lng)
  .htmlElement(d => {
    const el = document.createElement('div');
    el.className = 'geo-chip';
    el.textContent = d.name;
    el.style.pointerEvents = 'auto';
    el.addEventListener('click', e => {
      e.stopPropagation();
      const feat = REGIONS.features.find(f => f.properties.id === d.id);
      if (feat) focusRegion(feat.properties);
    });
    return el;
  })

  // ── Selectable region polygons ──
  .polygonsData(REGIONS.features)
  .polygonAltitude(0.018)
  .polygonCapColor(d => d === hoveredPolygon ? 'rgba(56,189,248,0.20)' : 'rgba(56,189,248,0.025)')
  .polygonSideColor(d => d === hoveredPolygon ? 'rgba(56,189,248,0.38)' : 'rgba(56,189,248,0.08)')
  .polygonStrokeColor(d => d === hoveredPolygon ? '#38bdf8' : 'rgba(56,189,248,0.32)')

  // ── Hover ──
  .onPolygonHover(poly => {
    if (hoveredPolygon === poly) return;
    hoveredPolygon = poly;
    globe
      .polygonCapColor(d => d === hoveredPolygon ? 'rgba(56,189,248,0.20)' : 'rgba(56,189,248,0.025)')
      .polygonSideColor(d => d === hoveredPolygon ? 'rgba(56,189,248,0.38)' : 'rgba(56,189,248,0.08)')
      .polygonStrokeColor(d => d === hoveredPolygon ? '#38bdf8' : 'rgba(56,189,248,0.32)');
    document.getElementById('globe-viz').style.cursor = poly ? 'pointer' : 'default';
  })
  .onPolygonClick(poly => poly && focusRegion(poly.properties));

// ──── Three.js material & satellite post-init ──────────
setTimeout(() => {
  const mat = globe.globeMaterial();
  mat.color     = new THREE.Color('#05111e');
  mat.specular  = new THREE.Color('#1e6fd9');
  mat.shininess = 18;

  // Load ocean specular mask for water shimmer
  new THREE.TextureLoader().load(
    'https://cdn.jsdelivr.net/npm/three-globe/example/img/earth-water.png',
    tex => { mat.specularMap = tex; mat.needsUpdate = true; }
  );

  // Directional key light (top-right) — makes coastlines glow
  const keyLight = new THREE.DirectionalLight(0x4488ff, 0.6);
  keyLight.position.set(200, 100, 80);
  globe.scene().add(keyLight);

  // Orbiting satellite shell
  satelliteGroup = new THREE.Group();
  globe.scene().add(satelliteGroup);

  const satGeo = new THREE.SphereGeometry(0.36, 6, 6);
  const satMat = new THREE.MeshBasicMaterial({ color: 0xd4eeff, transparent: true, opacity: 0.72 });
  const R = 134;

  for (let i = 0; i < 28; i++) {
    const mesh = new THREE.Mesh(satGeo, satMat.clone());
    const theta = Math.random() * Math.PI * 2;
    const phi   = Math.acos((Math.random() * 2) - 1);
    mesh.position.set(
      R * Math.sin(phi) * Math.cos(theta),
      R * Math.sin(phi) * Math.sin(theta),
      R * Math.cos(phi)
    );
    satelliteGroup.add(mesh);
  }
}, 150);

// Satellite animation loop
(function animateSats() {
  requestAnimationFrame(animateSats);
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced && satelliteGroup && layerVis.satellites) {
    satelliteGroup.rotation.y += 0.0008;
    satelliteGroup.rotation.x += 0.00025;
  }
  if (satelliteGroup) satelliteGroup.visible = layerVis.satellites;
})();

