// ──── Coordinate readout (raycasting) ─────────────────
const raycaster = new THREE.Raycaster();
const mouse2    = new THREE.Vector2();
const gviz      = document.getElementById('globe-viz');

gviz.addEventListener('mousemove', ev => {
  try {
    const r = gviz.getBoundingClientRect();
    mouse2.x = ((ev.clientX - r.left) / r.width)  *  2 - 1;
    mouse2.y = ((ev.clientY - r.top)  / r.height) * -2 + 1;
    raycaster.setFromCamera(mouse2, globe.camera());
    const hits = raycaster.intersectObjects(globe.scene().children, true);
    const hit  = hits.find(h => h.object.isMesh && !h.object.parent?.isGroup);
    if (hit) {
      const { x, y, z } = hit.point;
      const R   = Math.sqrt(x*x + y*y + z*z);
      const lat = Math.asin(Math.max(-1, Math.min(1, y / R))) * 180 / Math.PI;
      const lon = Math.atan2(x, z) * 180 / Math.PI;
      document.getElementById('lat-val').textContent =
        `${Math.abs(lat).toFixed(2)}°${lat >= 0 ? 'N' : 'S'}`;
      document.getElementById('lon-val').textContent =
        `${Math.abs(lon).toFixed(2)}°${lon >= 0 ? 'E' : 'W'}`;
    }
  } catch(_) {}
});

gviz.addEventListener('mouseleave', () => {
  document.getElementById('lat-val').textContent = '18.62°N';
  document.getElementById('lon-val').textContent = '72.36°E';
});

// ──── Modal ────────────────────────────────────────────
const modal      = document.getElementById('details-modal');
const modalTitle = document.getElementById('modal-region-title');
const panelTitle = document.getElementById('main-panel-title');

function focusRegion(props) {
  // Update panel heading
  panelTitle.textContent = `${props.name} Live Operations`;

  // Fly camera to region
  controls.autoRotate = false;
  rotationPaused = true;
  globe.pointOfView(props.center, 1200);

  // Fill modal content
  modalTitle.textContent = `SELECTED REGION: ${props.name.toUpperCase()}`;
  fillModal(props.data);

  // Reset tabs to [Ocean Data]
  document.querySelectorAll('.mtab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  document.querySelector('.mtab[data-tab="tab-ocean"]').classList.add('active');
  document.getElementById('tab-ocean').classList.add('active');

  modal.classList.remove('hidden');
}

function fillModal(d) {
  // Ocean tab
  el('val-sst').textContent      = `${d.sst} °C`;
  setStatus('sst-status',      d.sstStatus,      d.sstStatus === 'critical' ? '+3.4°C ANOMALY' : d.sstStatus.toUpperCase());
  el('val-salinity').textContent = `${d.salinity} psu`;
  setStatus('salinity-status', d.salinityStatus, d.salinityStatus.toUpperCase());
  el('val-oxygen').textContent   = `${d.oxygen} ml/L`;
  setStatus('oxygen-status',   d.oxygenStatus,   d.oxygenStatus.toUpperCase());
  el('val-current').textContent  = `${d.current} m/s`;
  setStatus('current-status',  d.currentStatus,  d.currentStatus.toUpperCase());

  // Bio tab
  el('val-species').textContent  = d.species;
  el('val-coral').textContent    = `${d.coral} %`;
  setStatus('coral-status',    d.coralStatus,    d.coralStatus.toUpperCase());
  el('val-phyto').textContent    = `${d.phyto} mg/m³`;
  setStatus('phyto-status',    d.phytoStatus,    d.phytoStatus.toUpperCase());

  // Alerts tab
  el('val-alert-title').textContent  = d.alertTitle;
  el('val-alert-desc').textContent   = d.alertDesc;
  el('val-alert-count').textContent  = d.alertCount;
  el('val-alert-severity').textContent = d.alertSeverity;

  const banner = el('alert-main-banner');
  const icon   = banner.querySelector('.ab-icon');
  if (d.alertSeverity === 'NONE') {
    banner.className = 'ab-banner stable';
    icon.style.background = 'var(--positive)';
  } else {
    banner.className = 'ab-banner critical';
    icon.style.background = 'var(--critical)';
  }
  el('val-alert-severity').className =
    `ab-sev ${d.alertSeverity === 'CRITICAL' ? 'critical' : d.alertSeverity === 'NONE' ? 'none' : 'critical'}`;

  // Ops tab
  el('val-ops-argo').textContent      = d.opsArgo;
  el('val-ops-satellites').textContent= d.opsSatellites;
  el('val-ops-bio').textContent       = d.opsBio;
  el('val-ops-time').textContent      = d.opsTime;
}

function setStatus(id, cls, txt) {
  const e = el(id);
  e.className = `dc-status ${cls}`;
  e.textContent = txt;
}
function el(id) { return document.getElementById(id); }

// Close modal
el('modal-close-btn').addEventListener('click', closeModal);
modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
function closeModal() {
  modal.classList.add('hidden');
  rotationPaused = false;
  controls.autoRotate = true;
  panelTitle.textContent = 'Indian Ocean Live Operations';
  document.querySelectorAll('.sub-item').forEach(b => b.classList.remove('active'));
}

// Modal tabs
document.querySelectorAll('.mtab').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.mtab').forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected','false'); });
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    btn.classList.add('active'); btn.setAttribute('aria-selected','true');
    el(btn.dataset.tab).classList.add('active');
  });
});

