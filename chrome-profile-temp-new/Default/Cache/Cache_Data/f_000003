/** ARGO floats: 6 current-corridor bands + noise + alert clusters */
function buildArgoPoints() {
  const pts = [];
  const corridors = [
    // [startLat, startLng, endLat, endLng, count, jitter]
    [25, -80, 48, -38,  40, 3.5],  // Gulf Stream
    [20, 122, 42, 152,  38, 3.0],  // Kuroshio
    [2,  45,  16, 65,   32, 2.5],  // Somali Current / Arabian Sea feed
    [10, 76, -10, 96,   36, 2.8],  // Equatorial IO
    [-8, 145,-26, 160,  30, 2.2],  // GBR / Coral Sea
    [30, -6,  42, 28,   28, 2.0],  // Mediterranean
    [-5, -40,-35, 20,   34, 3.2],  // South Atlantic
    [35, 135, 55, 155,  28, 2.6],  // North Pacific
  ];

  corridors.forEach(([slat, slng, elat, elng, n, jit]) => {
    for (let i = 0; i < n; i++) {
      const t = i / (n - 1);
      pts.push({
        lat: slat + (elat - slat) * t + (Math.random() - 0.5) * jit,
        lng: slng + (elng - slng) * t + (Math.random() - 0.5) * jit,
        type: 'argo', color: '#38bdf8',
        radius: 0.15 + Math.random() * 0.12
      });
    }
  });

  // Background scatter (lower density, biased to open ocean)
  for (let i = 0; i < 120; i++) {
    const lat = (Math.random() - 0.5) * 130;
    const lng = (Math.random() - 0.5) * 360;
    pts.push({ lat, lng, type: 'argo', color: '#38bdf8', radius: 0.12 + Math.random() * 0.10 });
  }

  // ── Arabian Sea heat cluster (red/orange bloom) ──
  for (let i = 0; i < 32; i++) {
    const r = Math.sqrt(Math.random()) * 6;
    const a = Math.random() * 2 * Math.PI;
    pts.push({
      lat: 15.3 + r * Math.sin(a),
      lng: 63.8 + r * Math.cos(a),
      type: 'heat',
      color: i < 20 ? '#ff5a5a' : '#ffb454',
      radius: 0.20 + Math.random() * 0.18
    });
  }

  // ── Coral Sea bio-bleaching cluster (orange) ──
  for (let i = 0; i < 22; i++) {
    const r = Math.sqrt(Math.random()) * 5;
    const a = Math.random() * 2 * Math.PI;
    pts.push({
      lat: -18 + r * Math.sin(a),
      lng: 152 + r * Math.cos(a),
      type: 'heat',
      color: '#ffb454',
      radius: 0.18 + Math.random() * 0.14
    });
  }

  return pts;
}

