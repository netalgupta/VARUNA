/** Telemetry arcs: hub-to-float spoke pattern */
function buildArcs() {
  const hubs = [
    { lat: 19.0, lng: 72.8 },
    { lat: 34.3, lng: 137.2 },
    { lat: 35.7, lng: -75.5 },
    { lat: 51.5, lng: -0.1 },
    { lat: -18.2, lng: 146.5 },
    { lat: 21.3, lng: -157.8 },
  ];
  const cols = ['#38bdf8', '#34e2a6', '#38bdf8', '#1e6fd9'];
  const arcs = [];
  hubs.forEach(hub => {
    for (let i = 0; i < 5; i++) {
      const d = 9 + Math.random() * 14;
      const a = Math.random() * 2 * Math.PI;
      arcs.push({
        startLat: hub.lat + d * Math.sin(a),
        startLng: hub.lng + d * Math.cos(a),
        endLat: hub.lat, endLng: hub.lng,
        color: cols[Math.floor(Math.random() * cols.length)],
        alt: 0.10 + Math.random() * 0.22
      });
    }
  });
  return arcs;
}

/** Alert pulse rings (Arabian Sea + Coral Sea) */
