});

// Top-level nav — simple active toggle
document.querySelectorAll('.menu-item').forEach(btn => {
  if (btn.id === 'nav-ocean-trigger') return;
  btn.addEventListener('click', () => {
    document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('active'));
    btn.classList.add('active');
  });
});

// ──── Alert cards ──────────────────────────────────────
document.querySelectorAll('.alert-card').forEach(card => {
  // Dismiss
  card.querySelector('.ac-close')?.addEventListener('click', e => {
    e.stopPropagation();
    card.classList.add('dismissed');
    setTimeout(() => card.remove(), 280);
  });
  // Goto → button
  card.querySelector('.ac-goto-btn')?.addEventListener('click', e => {
    e.stopPropagation();
    clickCardRegion(card);
  });
  // Card body click
  card.addEventListener('click', () => clickCardRegion(card));
  card.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') clickCardRegion(card); });
});
function clickCardRegion(card) {
  const feat = REGIONS.features.find(f => f.properties.id === card.dataset.region);
  if (feat) focusRegion(feat.properties);
}

// ──── Legend layer toggles ─────────────────────────────
function refreshPoints() {
  globe.pointsData(getVisiblePoints());
}
el('layer-argo').addEventListener('change', e => { layerVis.argo = e.target.checked; refreshPoints(); });
el('layer-sensors').addEventListener('change', e => { layerVis.sensors = e.target.checked; refreshPoints(); });
el('layer-satellites').addEventListener('change', e => { layerVis.satellites = e.target.checked; });

// ──── Control buttons ──────────────────────────────────
el('ctrl-recenter').addEventListener('click', () => {
  globe.pointOfView({ lat: 10, lng: 74, altitude: 2.05 }, 900);
  controls.autoRotate = true;
  rotationPaused = false;
  panelTitle.textContent = 'Indian Ocean Live Operations';
  document.querySelectorAll('.sub-item').forEach(b => b.classList.remove('active'));
  modal.classList.add('hidden');
});

el('ctrl-snapshot').addEventListener('click', () => {
  const cvs = document.querySelector('#globe-viz canvas');
  if (!cvs) return;
  const a = document.createElement('a');
  a.download = `varuna-${new Date().toISOString().slice(0,10)}.png`;
  a.href = cvs.toDataURL();
  a.click();
});

// ──── Mobile bar ───────────────────────────────────────
document.querySelectorAll('.mob-tab').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.mob-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    if (btn.id === 'mob-ocean') {
      const feat = REGIONS.features.find(f => f.properties.id === 'eq_indian_ocean');
      if (feat) focusRegion(feat.properties);
    } else if (btn.id === 'mob-alerts') {
      const feat = REGIONS.features.find(f => f.properties.id === 'arabian_sea');
      if (feat) focusRegion(feat.properties);
    }
  });
});

el('mob-alert-pill')?.addEventListener('click', () => {
  const feat = REGIONS.features.find(f => f.properties.id === 'arabian_sea');
  if (feat) focusRegion(feat.properties);
});

// ──── Ctrl+K shortcut ─────────────────────────────────
window.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
    e.preventDefault();
    el('global-search')?.focus();
  }
  if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
});

// ──── UTC clock ───────────────────────────────────────
function tickClock() {
  const now  = new Date();
  const hh   = String(now.getUTCHours()).padStart(2, '0');
  const mm   = String(now.getUTCMinutes()).padStart(2, '0');
  const ss   = String(now.getUTCSeconds()).padStart(2, '0');
  el('system-time').textContent = `${hh}:${mm}:${ss} UTC`;
}
setInterval(tickClock, 1000);
tickClock();

// ──── Responsive resize ───────────────────────────────
window.addEventListener('resize', () => {
  globe.width(window.innerWidth).height(window.innerHeight);
});
